# local env files
.env*.local
.env
# .env.example is deliberately NOT ignored (BRK-24). It is the only record of
# which variables the app needs, and hiding it meant a fresh clone had to
# discover them by reading lib/supabase.ts and waiting for a runtime failure.
# It contains placeholders only — no real values — and the check that keeps it
# that way is that every var in it is EXPO_PUBLIC_*, which by definition ends
# up in the client bundle anyway. Anything genuinely secret belongs in Supabase
# Edge Function secrets, never in this file.

# Claude Code local skill symlinks (absolute paths, machine-specific)
.claude/

# Firebase service-account keys — PRIVATE. These grant send permission on the
# Firebase project and must never reach this public repo. Upload them to
# expo.dev → Credentials instead and keep the file outside the working tree.
# (google-services.json is NOT secret and is intentionally committed.)
*-firebase-adminsdk-*.json
*service-account*.json
serviceAccountKey.json

# ── Role-tour harness (e2e/) ──────────────────────────────
# Run artifacts. known-failures.json and accounts.example.json ARE tracked;
# real credentials and generated output never are.
e2e/shots/
e2e/report.json
e2e/accounts.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

