# =====================================================
# HealthDrop environment — copy to .env and fill in.
# Only EXPO_PUBLIC_* vars exist here; they are embedded
# in the client bundle, so nothing secret ever goes in
# this file. Server-side secrets (service_role key,
# OpenRouter server key) live ONLY in Supabase Edge
# Function secrets — never in the repo.
# =====================================================

# ── Supabase (required) ──────────────────────────────
# Read by lib/supabase.ts. EXPO_PUBLIC_SUPABASE_KEY is the modern
# publishable key (sb_publishable_...). EXPO_PUBLIC_SUPABASE_ANON_KEY
# is the legacy JWT anon key name, still accepted as a fallback.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key_here

# ── OpenRouter AI ────────────────────────────────────
# There is NO client-side OpenRouter key, and there must not be one.
# AI insights and chat go through the 'openrouter-proxy' Edge Function,
# which holds the key server-side, allowlists the model and caps tokens.
#
# This block used to offer EXPO_PUBLIC_OPENROUTER_API_KEY as a "direct-API
# fallback when the proxy is unavailable". That fallback no longer exists
# anywhere in the code (verified 2026-08-02: zero references to
# EXPO_PUBLIC_OPENROUTER_API_KEY or openrouter.ai outside the Edge
# Function). Setting one would not enable anything — it would only paste a
# billable key into the client bundle, where anyone with the APK can read
# it. The variable is deliberately not listed here.
#
# Configure the key as an Edge Function secret instead:
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...

# ── Feature flags ────────────────────────────────────
# Offline-first report queue (App.tsx). Defaults to true when unset.
EXPO_PUBLIC_OFFLINE_SYNC_ENABLED=true

# ── EAS builds ───────────────────────────────────────
# CI / EAS builds do NOT read this file. Set the same EXPO_PUBLIC_*
# variables in the EAS environment (expo.dev -> project -> Environment
# variables, or `eas env:create`) for the 'preview' and 'production'
# environments.
