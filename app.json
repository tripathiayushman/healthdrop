{
  "expo": {
    "name": "HealthDrop",
    "slug": "health-drop",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripathiayushman.healthdrop",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.tripathiayushman.healthdrop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "sdkVersion": "54.0.0",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HealthDrop to access your location to auto-fill district and state."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a4f36a3-4383-4310-8e55-c85c2f28ab08"
      }
    },
    "owner": "tripathiayushman"
  }
}
